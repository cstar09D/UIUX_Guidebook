# 로컬 실행과 Vercel 모두 Turso DB 서버를 사용합니다. 아래 네 값을 설정하세요.
# 로컬 설정은 Git에서 제외되는 .env.local에 저장합니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# npm run admin:credentials로 생성합니다. Vercel에는 \ 없는 원래 scrypt$... 값을 넣습니다.
# Next dotenv 파일에서는 $를 \$로 이스케이프합니다.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
