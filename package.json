{
  "name": "ui-notes-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "demos": "node scripts/build-demos.mjs",
    "dev": "npm run demos && next dev --hostname 127.0.0.1 --port 3000",
    "build": "npm run demos && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:cloud": "node --env-file-if-exists=.env.deploy.local scripts/migrate-cloud.mjs",
    "admin:credentials": "node scripts/admin-credentials.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "jose": "^6.2.18",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": "22.x"
  }
}
